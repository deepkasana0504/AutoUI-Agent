# Gateway-side JSON maps. Use long random secrets; never commit real values.
AUTOUI_DEVICE_TOKENS={"device-001":"replace-with-long-random-device-secret"}
AUTOUI_DEVICE_OWNERS={"device-001":"user-001"}
AUTOUI_USER_TOKENS={"replace-with-long-random-user-token":"user-001"}
AUTOUI_COMMAND_TIMEOUT=45
AUTOUI_MCP_ALLOWED_HOSTS=["localhost:*","127.0.0.1:*","api.your-domain.example","api.your-domain.example:*"]
AUTOUI_MCP_ALLOWED_ORIGINS=[]
HOST=0.0.0.0
PORT=8000

# Customer-device environment (set these on the device, not on the gateway):
# AUTOUI_GATEWAY_URL=wss://your-domain.example/agent/ws
# AUTOUI_DEVICE_ID=device-001
# AUTOUI_DEVICE_TOKEN=replace-with-long-random-device-secret
